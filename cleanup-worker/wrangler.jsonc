
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "campusmart-document-cleanup",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "campusmart-photos"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
