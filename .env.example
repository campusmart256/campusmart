# Copy this file to ".env" (same folder) and fill in the two values from
# Supabase > Project Settings > API. Use the PUBLIC key only (anon or publishable).
# NEVER put the service_role / secret key here.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
PUBLIC_SUPABASE_KEY=your-public-anon-or-publishable-key
